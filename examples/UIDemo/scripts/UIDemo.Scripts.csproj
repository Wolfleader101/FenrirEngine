<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>UIDemo.Scripts</AssemblyName>
    <RootNamespace>UIDemo.Scripts</RootNamespace>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>
  <!-- UIDemo's C# variant (examples/UIDemo/README.md): a speedometer painted on the HUD in the Fenrir.UI.Paint stage,
       and the pause menu's clicks read through EventReader<UIEvent>. fenrir_add_demo_app's SCRIPTS builds it, passing
       -p:FenrirScriptingSdk=<the SDK folder>/ and the folder of each contract (-p:Fenrir<Name>ContractDir=), the
       Text, Painter and UI ones among them whenever their scripting extensions are built. The contracts are
       compile-time only: the host shares its own copies. -->
  <Import Project="$(MSBuildThisFileDirectory)../../../packages/FenrirScripting/Managed/Fenrir.Scripting.InRepo.props" />
  <ItemGroup Condition="'$(FenrirDemoContractDir)' != ''">
    <Reference Include="Fenrir.Input">
      <HintPath>$(FenrirInputContractDir)Fenrir.Input.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Fenrir.Assets">
      <HintPath>$(FenrirAssetsContractDir)Fenrir.Assets.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Fenrir.Renderer">
      <HintPath>$(FenrirRendererContractDir)Fenrir.Renderer.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Fenrir.DebugDraw">
      <HintPath>$(FenrirDebugDrawContractDir)Fenrir.DebugDraw.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Fenrir.Demo">
      <HintPath>$(FenrirDemoContractDir)Fenrir.Demo.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Fenrir.Text">
      <HintPath>$(FenrirTextContractDir)Fenrir.Text.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Fenrir.Painter">
      <HintPath>$(FenrirPainterContractDir)Fenrir.Painter.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Fenrir.UI">
      <HintPath>$(FenrirUIContractDir)Fenrir.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <!-- In an editor, which passes no folders, the contracts come from their source projects. -->
  <ItemGroup Condition="'$(FenrirDemoContractDir)' == ''">
    <ProjectReference Include="$(MSBuildThisFileDirectory)../../../packages/FenrirInput/Managed/Fenrir.Input/Fenrir.Input.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="$(MSBuildThisFileDirectory)../../../packages/FenrirAssets/Managed/Fenrir.Assets/Fenrir.Assets.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="$(MSBuildThisFileDirectory)../../../packages/FenrirRenderer/Managed/Fenrir.Renderer/Fenrir.Renderer.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="$(MSBuildThisFileDirectory)../../../packages/FenrirDebugDraw/Managed/Fenrir.DebugDraw/Fenrir.DebugDraw.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="$(MSBuildThisFileDirectory)../../DemoScaffold/Managed/Fenrir.Demo/Fenrir.Demo.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="$(MSBuildThisFileDirectory)../../../packages/FenrirText/Managed/Fenrir.Text/Fenrir.Text.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="$(MSBuildThisFileDirectory)../../../packages/FenrirPainter/Managed/Fenrir.Painter/Fenrir.Painter.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="$(MSBuildThisFileDirectory)../../../packages/FenrirUI/Managed/Fenrir.UI/Fenrir.UI.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>
</Project>
