<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Version is part of the contract: the host shares one copy, and a script compiled against a newer minor fails to load. -->
    <Version>0.1.0</Version>
    <AssemblyName>Fenrir.Demo</AssemblyName>
    <RootNamespace>Fenrir.Demo</RootNamespace>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>
  <!-- The demo scaffold's shared C# assembly (examples/DemoScaffold/README.md): the CSharpScene marker and the scene-click
       event, which every demo app's scripts project references. Built against the scripting SDK (for the generators and
       Fenrir.Math); CMake passes -p:FenrirScriptingSdk=<the SDK folder>/. The host shares it with every script load. -->
  <Import Project="$(MSBuildThisFileDirectory)../../../../packages/FenrirScripting/Managed/Fenrir.Scripting.InRepo.props" />
</Project>
