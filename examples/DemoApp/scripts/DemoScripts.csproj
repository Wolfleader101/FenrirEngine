<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <!-- The scripting SDK: the Fenrir.Scripting contract and the source generator. CMake passes -p:FenrirScriptingSdk=<folder>/ when
       it builds this project (see examples/DemoApp/CMakeLists.txt); building it by hand needs the same, for example
       dotnet build -p:FenrirScriptingSdk=<build>/fenrir-scripting/contract/ -->
  <Import Project="$(FenrirScriptingSdk)Fenrir.Scripting.props" />
</Project>
