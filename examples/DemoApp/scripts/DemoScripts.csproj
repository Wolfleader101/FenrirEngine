<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <!-- The scripting SDK: the Fenrir.Scripting and Fenrir.Math contracts and the source generator. A project outside this
       repository imports the SDK folder's props directly: <Import Project="$(FenrirScriptingSdk)Fenrir.Scripting.props" /> with -p:FenrirScriptingSdk=<folder>/.
       This one is in the repo, so it uses the in-repo props: CMake passes the built SDK folder, and an editor (which opens this file
       alone) gets the contract and generator from their sources, so IntelliSense works with nothing built. -->
  <Import Project="$(MSBuildThisFileDirectory)../../../packages/FenrirScripting/Managed/Fenrir.Scripting.InRepo.props" />
  <!-- Physics from C#: the scripts in Physics/ use the Fenrir.Physics contract, compile-time only (the host shares its own copy).
       CMake passes -p:FenrirPhysicsContractDir=<the folder holding Fenrir.Physics.dll>/ when physics is built in, and leaves
       Physics/ out when it is not. An editor (which passes neither property) references the contract's source project, so
       IntelliSense works there too. -->
  <ItemGroup Condition="'$(FenrirPhysicsContractDir)' != ''">
    <Reference Include="Fenrir.Physics">
      <HintPath>$(FenrirPhysicsContractDir)Fenrir.Physics.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(FenrirPhysicsContractDir)' == '' and '$(FenrirScriptingSdk)' == ''">
    <ProjectReference Include="$(MSBuildThisFileDirectory)../../../packages/FenrirPhysics/Managed/Fenrir.Physics/Fenrir.Physics.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup Condition="'$(FenrirPhysicsContractDir)' == '' and '$(FenrirScriptingSdk)' != ''">
    <Compile Remove="Physics/**" />
  </ItemGroup>
</Project>
