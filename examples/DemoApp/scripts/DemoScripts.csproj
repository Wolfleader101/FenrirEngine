<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <!-- The scripting SDK: the Fenrir.Scripting contract and the source generator. A project outside this repository imports the SDK
       folder's props directly: <Import Project="$(FenrirScriptingSdk)Fenrir.Scripting.props" /> with -p:FenrirScriptingSdk=<folder>/.
       This one is in the repo, so it uses the in-repo props: CMake passes the built SDK folder, and an editor (which opens this file
       alone) gets the contract and generator from their sources, so IntelliSense works with nothing built. -->
  <Import Project="$(MSBuildThisFileDirectory)../../../packages/FenrirScripting/Managed/Fenrir.Scripting.InRepo.props" />
</Project>
