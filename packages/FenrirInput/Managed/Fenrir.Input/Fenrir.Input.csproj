<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Version is part of the contract: the host shares one copy, and a script compiled against a newer minor fails to load. -->
    <Version>0.1.0</Version>
    <AssemblyName>Fenrir.Input</AssemblyName>
    <RootNamespace>Fenrir.Input</RootNamespace>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>
  <!-- FenrirInput's scripting contract (ADR-0009, ADR-0029): the C# mirrors of the input types, events and input claims, and the
       facades over the native functions FenrirInputScripting gives C#. Built against the scripting SDK (for IEvent, IReadOnlyResource and the
       generators); CMake passes -p:FenrirScriptingSdk=<the SDK folder>/. The host shares it with every script load. -->
  <Import Project="$(MSBuildThisFileDirectory)../../../FenrirScripting/Managed/Fenrir.Scripting.InRepo.props" />
</Project>
