      "name": "Seek",
      "namespace": "Fenrir::AnimationNatives",
      "source": "../src/AnimationScripting.cpp",
      "state": "Fenrir::AnimationScripting",
      "doc": "Queues a seek of the entity's playback cursor to `seconds` (C++'s Animation::Seek): the skeleton entity for its Animator, or a layer entity. Applied at its next evaluation, after any clip change; crosses no events, and works while paused.",
      "facade": "Animation.Seek",
      "returns": {
        "type": "bool",
        "kind": "bool",
        "doc": "Whether it was queued: false for an entity that is not alive."
      },
      "parameters": [
        {
          "name": "entity",
          "type": "const Fenrir::Entity*",
          "kind": "pointer",
          "pointee": "Fenrir::Entity",
          "pointeeKind": "struct",
          "const": true
        },
        {
          "name": "seconds",
          "type": "double",
          "kind": "f64"
        }
      ]
    },
