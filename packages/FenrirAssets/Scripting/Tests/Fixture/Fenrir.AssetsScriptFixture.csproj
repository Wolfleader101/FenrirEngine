<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>
  <!-- A script assembly that uses the asset store from C#. The build passes -p:FenrirScriptingSdk=<the SDK folder>/ and
       -p:FenrirAssetsContractDir=<the folder holding Fenrir.Assets.dll>/. The contract is compile-time only: the host shares
       its own copy. -->
  <Import Project="$(MSBuildThisFileDirectory)../../../../FenrirScripting/Managed/Fenrir.Scripting.InRepo.props" />
  <!-- The generated defaults test's C# half (../Generated, from Scripting/api/FenrirAssets.binding.toml). -->
  <ItemGroup>
    <Compile Include="../Generated/*.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(FenrirAssetsContractDir)' != ''">
    <Reference Include="Fenrir.Assets">
      <HintPath>$(FenrirAssetsContractDir)Fenrir.Assets.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <!-- In an editor, which passes no folders, the contract comes from its source project. -->
  <ItemGroup Condition="'$(FenrirAssetsContractDir)' == ''">
    <ProjectReference Include="$(MSBuildThisFileDirectory)../../../Managed/Fenrir.Assets/Fenrir.Assets.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>
</Project>
