# Writes a file's bytes into a C++ header as `inline constexpr std::uint8_t <NAME>[]` in namespace Fenrir::Resources,
# so the renderer carries a resource (the debug font) with no file beside it. Run as a script by the build:
#   cmake -DINPUT=<file> -DOUTPUT=<header> -DNAME=<identifier> -P EmbedBytes.cmake
# CMake does it all, so the build needs no other tool.
foreach(required INPUT OUTPUT NAME)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "EmbedBytes.cmake: ${required} is required")
    endif()
endforeach()

file(READ "${INPUT}" hex HEX)
# Two hex digits a byte; 12 bytes a line, so no line is long enough to trouble a compiler.
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
string(REGEX REPLACE "(0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],)" "\\1\n" bytes "${bytes}")
get_filename_component(source_name "${INPUT}" NAME)

file(WRITE "${OUTPUT}"
     "// Generated by EmbedBytes.cmake from ${source_name}. Do not edit.\n"
     "#pragma once\n\n"
     "#include <cstdint>\n\n"
     "namespace Fenrir::Resources\n{\n"
     "inline constexpr std::uint8_t ${NAME}[] = {\n${bytes}\n};\n"
     "} // namespace Fenrir::Resources\n")
