<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Version is part of the contract: the host shares one copy, and a script compiled against a newer minor fails to load. -->
    <Version>0.1.0</Version>
    <AssemblyName>Fenrir.Text</AssemblyName>
    <RootNamespace>Fenrir.Text</RootNamespace>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>
  <!-- FenrirText's scripting contract (ADR-0029, ADR-0061): the Fonts facade and the paragraphs, over the native
       functions FenrirTextScripting gives C#. Built against the scripting SDK (for the generators and Fenrir.Math);
       CMake passes -p:FenrirScriptingSdk=<the SDK folder>/. The host shares it with every script load. -->
  <Import Project="$(MSBuildThisFileDirectory)../../../FenrirScripting/Managed/Fenrir.Scripting.InRepo.props" />
</Project>
