    {
      "name": "AddFace",
      "namespace": "Fenrir::TextNatives",
      "source": "../src/TextScripting.cpp",
      "state": "Fenrir::TextScripting",
      "doc": "Registers the font file at `path` (TrueType or OpenType, loaded once as a Font asset the app owns) as the face of `family` at `weight` and `style` in the app's FontLibrary, replacing any face registered there (FontLibrary::AddFace). Paragraphs laid out in the library lay out again on their next Layout.",
      "facade": "Fonts.AddFace",
      "returns": {
        "type": "bool",
        "kind": "bool",
        "doc": "Whether the face was registered: false when the file does not load, or the app has no FontLibrary or AssetStore."
      },
      "parameters": [
        {
          "name": "family",
          "type": "std::string_view",
          "kind": "string",
          "doc": "The family's name, as text styles name it."
        },
        {
          "name": "path",
          "type": "std::string_view",
          "kind": "string",
          "doc": "The font file: relative to the asset root, or absolute."
        },
        {
          "name": "weight",
          "type": "std::uint16_t",
          "kind": "u16",
          "doc": "The CSS weight, 100 to 900; 400 is normal and 700 bold."
        },
        {
          "name": "style",
          "type": "Fenrir::FontStyle",
          "kind": "enum",
          "doc": "Upright or italic."
        }
      ]
    },
