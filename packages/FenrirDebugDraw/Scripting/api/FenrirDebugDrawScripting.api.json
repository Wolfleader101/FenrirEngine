        {
          "name": "r",
          "offset": 0,
          "kind": "f32",
          "default": 1
        },
        {
          "name": "g",
          "offset": 4,
          "kind": "f32",
          "default": 1
        },
        {
          "name": "b",
          "offset": 8,
          "kind": "f32",
          "default": 1
        },
        {
          "name": "a",
          "offset": 12,
          "kind": "f32",
          "default": 1
        }
      ]
    },
    {
      "name": "Fenrir::DepthMode",
      "category": "enum",
      "size": 1,
      "alignment": 1,
      "doc": "Whether a shape is hidden behind what is in front of it.",
      "underlying": "u8",
      "values": [
        {
          "name": "Tested",
          "value": 0,
          "doc": "Tested against the scene's depth, so geometry in front hides it (the default)."
        },
        {
          "name": "OnTop",
          "value": 1,
          "doc": "Drawn over everything, never hidden."
        }
      ]
    },
