@* @ref on an element and on a component, both behind an @if (ChildComponentTests). *@
<panel class="refs">
    @if (Show)
    {
        <panel class="box" @ref="Box"></panel>
        <Badge Text="ref" @ref="Child" />
    }
</panel>

@code {
    public bool Show = true;
    public ElementReference Box;
    public Badge? Child;
    public ElementId BoxElement => ElementOf(Box);
}
