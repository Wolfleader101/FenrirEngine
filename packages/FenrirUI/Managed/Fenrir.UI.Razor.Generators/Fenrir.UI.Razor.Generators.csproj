<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Analyzers and generators load inside the compiler, which only guarantees netstandard2.0. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <AssemblyName>Fenrir.UI.Razor.Generators</AssemblyName>
    <RootNamespace>Fenrir.UI.Razor.Generators</RootNamespace>
    <!-- The compiler supplies Roslyn; nothing but this assembly is deployed. -->
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <!-- Release tracking files and message wording are for published analyzer packages; this generator ships in-tree. -->
    <NoWarn>$(NoWarn);RS1032;RS2008</NoWarn>
  </PropertyGroup>
  <!-- FenrirUI's Razor generator (ADR-0070), which Fenrir.UI.Razor.props adds beside the SDK's Razor generator: each
       Foo.razor.css beside a Foo.razor becomes [ComponentStylesheet(path, text)] on a partial Foo. The build puts it
       under analyzers/ in the Fenrir.UI.Razor folder; in the source tree the props reference this project instead. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
  </ItemGroup>
</Project>
