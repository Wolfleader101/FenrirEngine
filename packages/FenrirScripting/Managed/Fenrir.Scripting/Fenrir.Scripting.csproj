<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Version is part of the contract: the host shares one copy, and a script compiled against a newer minor fails to load. -->
    <Version>0.2.0</Version>
    <AssemblyName>Fenrir.Scripting</AssemblyName>
    <RootNamespace>Fenrir.Scripting</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- The engine's own components (Transform, Name, Relationship) live in this assembly, so the generator that gives
         every component its Ref<T> accessors runs on it too. -->
    <ProjectReference Include="../Fenrir.Scripting.Generators/Fenrir.Scripting.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="OutputPath;_CommandLineDefinedOutputPath" />
  </ItemGroup>
</Project>
