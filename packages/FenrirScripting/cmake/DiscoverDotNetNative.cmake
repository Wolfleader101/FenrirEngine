# Build-time SDK pack selection. Runtime hostfxr discovery remains nethost's job.
function(fenrir_discover_dotnet_native output_directory)
    if(CMAKE_CROSSCOMPILING)
        message(FATAL_ERROR "Cross-compilation requires an explicit FENRIR_DOTNET_NATIVE_DIR for the target SDK pack.")
    endif()

    set(FENRIR_DOTNET_TARGET_RID "" CACHE STRING "Override the target .NET RID, e.g. linux-musl-x64")
    if(FENRIR_DOTNET_TARGET_RID)
        set(target_rid "${FENRIR_DOTNET_TARGET_RID}")
    else()
        if(CMAKE_SYSTEM_NAME STREQUAL "Windows")
            set(target_os win)
        elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
            set(target_os linux)
        elseif(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
            set(target_os osx)
        else()
            message(FATAL_ERROR "Unknown .NET target OS. Set FENRIR_DOTNET_NATIVE_DIR explicitly.")
        endif()

        # Prefer the compiler/generator target over the build machine's processor.
        if(CMAKE_OSX_ARCHITECTURES)
            list(LENGTH CMAKE_OSX_ARCHITECTURES architecture_count)
            if(NOT architecture_count EQUAL 1)
                message(FATAL_ERROR "Universal builds need separate hosting builds for each architecture.")
            endif()
            set(target_processor "${CMAKE_OSX_ARCHITECTURES}")
        elseif(CMAKE_GENERATOR_PLATFORM)
            string(REGEX REPLACE ",.*$" "" target_processor "${CMAKE_GENERATOR_PLATFORM}")
        elseif(CMAKE_CXX_COMPILER_ARCHITECTURE_ID)
            set(target_processor "${CMAKE_CXX_COMPILER_ARCHITECTURE_ID}")
        else()
            set(target_processor "${CMAKE_SYSTEM_PROCESSOR}")
        endif()
        string(TOLOWER "${target_processor}" target_processor)
        if(target_processor MATCHES "^(arm64|aarch64)$" AND CMAKE_SIZEOF_VOID_P EQUAL 8)
            set(target_arch arm64)
        elseif(target_processor MATCHES "^(arm|armv[5-8].*)$" AND CMAKE_SIZEOF_VOID_P EQUAL 4)
            set(target_arch arm)
        elseif(target_processor MATCHES "^(x64|x86_64|amd64|x86|win32|i[3-6]86)$")
            if(CMAKE_SIZEOF_VOID_P EQUAL 8)
                set(target_arch x64)
            else()
                set(target_arch x86)
            endif()
        else()
            message(FATAL_ERROR "Unknown .NET target architecture '${target_processor}'. Set FENRIR_DOTNET_TARGET_RID or FENRIR_DOTNET_NATIVE_DIR.")
        endif()
        set(target_rid "${target_os}-${target_arch}")
    endif()

    find_program(FENRIR_DOTNET_EXECUTABLE NAMES dotnet HINTS "$ENV{DOTNET_ROOT}"
        DOC "dotnet executable used to locate installed SDK host packs")
    if(NOT FENRIR_DOTNET_EXECUTABLE)
        message(FATAL_ERROR "dotnet was not found. Install the .NET 10 SDK or set FENRIR_DOTNET_NATIVE_DIR explicitly.")
    endif()
    execute_process(COMMAND "${FENRIR_DOTNET_EXECUTABLE}" --list-sdks
        RESULT_VARIABLE sdk_result OUTPUT_VARIABLE sdk_output ERROR_VARIABLE sdk_error
        TIMEOUT 15 OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT sdk_result STREQUAL "0")
        message(FATAL_ERROR "dotnet --list-sdks failed (${sdk_result}): ${sdk_error}. Set FENRIR_DOTNET_NATIVE_DIR explicitly.")
    endif()

    string(REPLACE "\r" "" sdk_output "${sdk_output}")
    string(REPLACE "\n" ";" sdk_lines "${sdk_output}")
    set(pack_roots)
    foreach(sdk_line IN LISTS sdk_lines)
        if(sdk_line MATCHES "^[^ ]+ +\\[(.+)\\]$")
            file(TO_CMAKE_PATH "${CMAKE_MATCH_1}" sdk_directory)
            get_filename_component(dotnet_root "${sdk_directory}" DIRECTORY)
            list(APPEND pack_roots "${dotnet_root}/packs/Microsoft.NETCore.App.Host.${target_rid}")
        endif()
    endforeach()
    list(REMOVE_DUPLICATES pack_roots)

    set(selected_directory "")
    set(selected_version "0")
    foreach(pack_root IN LISTS pack_roots)
        file(GLOB pack_versions LIST_DIRECTORIES TRUE "${pack_root}/*")
        foreach(pack_directory IN LISTS pack_versions)
            get_filename_component(pack_version "${pack_directory}" NAME)
            # Match the bridge's net10.0 target; preview packs are opt-in via the path override.
            if(NOT pack_version MATCHES "^10\\.[0-9]+\\.[0-9]+$")
                continue()
            endif()
            set(native_directory "${pack_directory}/runtimes/${target_rid}/native")
            set(pack_complete TRUE)
            set(required_files nethost.h hostfxr.h coreclr_delegates.h
                "${CMAKE_SHARED_LIBRARY_PREFIX}nethost${CMAKE_SHARED_LIBRARY_SUFFIX}")
            if(WIN32)
                list(APPEND required_files nethost.lib)
            endif()
            foreach(required_file IN LISTS required_files)
                if(NOT EXISTS "${native_directory}/${required_file}" OR IS_DIRECTORY "${native_directory}/${required_file}")
                    set(pack_complete FALSE)
                endif()
            endforeach()
            if(pack_complete AND pack_version VERSION_GREATER selected_version)
                set(selected_version "${pack_version}")
                set(selected_directory "${native_directory}")
            endif()
        endforeach()
    endforeach()
    if(NOT selected_directory)
        message(FATAL_ERROR "No complete stable .NET 10 host pack for '${target_rid}' was found. Set FENRIR_DOTNET_NATIVE_DIR explicitly (and use linux-musl-* for musl targets).")
    endif()
    message(STATUS "Auto-selected .NET native host pack (${target_rid}, ${selected_version}): ${selected_directory}")
    set(${output_directory} "${selected_directory}" PARENT_SCOPE)
endfunction()
