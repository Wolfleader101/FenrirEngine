<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>
  <!-- An extension contract whose fields no extension satisfies, for the tests of what Install refuses. It is its own
       assembly because sharing an assembly with an unbound field fails, and sharing is permanent for the process. -->
</Project>
