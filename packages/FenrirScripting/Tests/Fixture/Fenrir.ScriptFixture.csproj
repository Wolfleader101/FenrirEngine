<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The two builds of the fixture have separate intermediate folders; neither may compile the other's generated files. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>
  <!-- The reload tests build this project twice: -p:FixtureVariant=2 is the "new build" that replaces the first. -->
  <PropertyGroup Condition="'$(FixtureVariant)' == '2'">
    <DefineConstants>$(DefineConstants);VARIANT2</DefineConstants>
  </PropertyGroup>
  <!-- A script project needs only the scripting SDK: its contract, and the source generator behind Ref<T>. The build
       passes -p:FenrirScriptingSdk=<the SDK folder>/. -->
  <Import Project="$(MSBuildThisFileDirectory)../../Managed/Fenrir.Scripting.InRepo.props" />
  <!-- The built-in binding's generated tests' C# halves (../Generated, from api/FenrirScripting.binding.toml). -->
  <ItemGroup>
    <Compile Include="../Generated/*.cs" />
  </ItemGroup>
</Project>
