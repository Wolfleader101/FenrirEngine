<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <!-- A script project needs only the scripting SDK: its contract, and the source generator behind Ref<T>. The build
       passes -p:FenrirScriptingSdk=<the SDK folder>/. -->
  <Import Project="$(FenrirScriptingSdk)Fenrir.Scripting.props" />
</Project>
