<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputType>Library</OutputType>
    <!-- Only the one case named by -p:Case=<Name> is compiled, against the scripting SDK and the Fenrir.Ragdoll contract
         with the Fenrir.Skeleton and Fenrir.Assets contracts it builds against (-p:FenrirRagdollContractDir=...,
         -p:FenrirSkeletonContractDir=... and -p:FenrirAssetsContractDir=..., each a folder holding its dll). -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)../../../../FenrirScripting/Managed/Fenrir.Scripting.InRepo.props" />
  <ItemGroup>
    <Compile Include="$(Case).cs" />
    <Reference Include="Fenrir.Assets">
      <HintPath>$(FenrirAssetsContractDir)Fenrir.Assets.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Fenrir.Skeleton">
      <HintPath>$(FenrirSkeletonContractDir)Fenrir.Skeleton.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Fenrir.Ragdoll">
      <HintPath>$(FenrirRagdollContractDir)Fenrir.Ragdoll.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
