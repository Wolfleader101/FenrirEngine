<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Version is part of the contract: the host shares one copy, and a script compiled against a newer minor fails to load. -->
    <Version>0.1.0</Version>
    <AssemblyName>Fenrir.Ragdoll</AssemblyName>
    <RootNamespace>Fenrir.Ragdoll</RootNamespace>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>
  <!-- FenrirRagdoll's scripting contract (the ragdolls spec, ticket 56): the Ragdoll and RagdollBody components, their
       modes and states, the humanoid bone map, the description handle and Ragdoll's statics over the native functions
       FenrirRagdollScripting gives C#. Built against the scripting SDK (for the generators) and the Fenrir.Skeleton
       contract (for BoneName) with the Fenrir.Assets one it uses; CMake passes -p:FenrirScriptingSdk=<the SDK folder>/,
       -p:FenrirAssetsContractDir=<the folder holding Fenrir.Assets.dll>/ and -p:FenrirSkeletonContractDir=<the folder
       holding Fenrir.Skeleton.dll>/. The host shares it with every script load, after Fenrir.Skeleton. -->
  <Import Project="$(MSBuildThisFileDirectory)../../../FenrirScripting/Managed/Fenrir.Scripting.InRepo.props" />
  <ItemGroup Condition="'$(FenrirSkeletonContractDir)' != ''">
    <Reference Include="Fenrir.Assets">
      <HintPath>$(FenrirAssetsContractDir)Fenrir.Assets.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Fenrir.Skeleton">
      <HintPath>$(FenrirSkeletonContractDir)Fenrir.Skeleton.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <!-- In an editor, which passes no folders, the contracts come from their source projects. -->
  <ItemGroup Condition="'$(FenrirSkeletonContractDir)' == ''">
    <ProjectReference Include="$(MSBuildThisFileDirectory)../../../FenrirSkeleton/Managed/Fenrir.Skeleton/Fenrir.Skeleton.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>
</Project>
