<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Version is part of the contract: the host shares one copy, and a script compiled against a newer minor fails to load. -->
    <Version>0.1.0</Version>
    <AssemblyName>Fenrir.Physics</AssemblyName>
    <RootNamespace>Fenrir.Physics</RootNamespace>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>
  <!-- FenrirPhysics's scripting contract (ADR-0009): the C# mirrors of the physics components and the declarations of the
       native functions FenrirPhysicsScripting gives C#. Built against the scripting SDK (for IComponent, Entity and the
       generators); CMake passes -p:FenrirScriptingSdk=<the SDK folder>/. The host shares it with every script load. -->
  <Import Project="$(MSBuildThisFileDirectory)../../../FenrirScripting/Managed/Fenrir.Scripting.InRepo.props" />
</Project>
