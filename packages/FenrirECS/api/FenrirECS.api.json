    {
      "name": "Fenrir::Relationship",
      "category": "struct",
      "role": "component",
      "size": 64,
      "alignment": 8,
      "doc": "Where an entity sits in the hierarchy: its parent, its first child and its siblings, each the empty Entity when there is none. Every entity has one, and the entity list keeps the links consistent.",
      "fields": [
        {
          "name": "parent",
          "offset": 0,
          "kind": "struct",
          "type": "Fenrir::Entity",
          "default": {},
          "doc": "The entity's parent."
        },
        {
          "name": "firstChild",
          "offset": 16,
          "kind": "struct",
          "type": "Fenrir::Entity",
          "default": {},
          "doc": "The first of its children; the rest follow through each child's nextSibling."
        },
        {
          "name": "nextSibling",
          "offset": 32,
          "kind": "struct",
          "type": "Fenrir::Entity",
          "default": {},
          "doc": "The next child of its parent."
        },
        {
          "name": "prevSibling",
          "offset": 48,
          "kind": "struct",
          "type": "Fenrir::Entity",
          "default": {},
          "doc": "The previous child of its parent."
        }
      ]
    },
