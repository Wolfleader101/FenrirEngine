<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>
  <!-- A script assembly that uses the window from C#. The build passes -p:FenrirScriptingSdk=<the SDK folder>/,
       -p:FenrirInputContractDir=<the folder holding Fenrir.Input.dll>/ and -p:FenrirWindowContractDir=<the folder holding
       Fenrir.Window.dll>/. The contracts are compile-time only: the host shares its own copies. -->
  <Import Project="$(MSBuildThisFileDirectory)../../../../FenrirScripting/Managed/Fenrir.Scripting.InRepo.props" />
  <ItemGroup>
    <!-- The generated defaults test's C# half (../Generated, from Scripting/api/FenrirWindow.binding.toml). -->
    <Compile Include="../Generated/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Fenrir.Input">
      <HintPath>$(FenrirInputContractDir)Fenrir.Input.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Fenrir.Window">
      <HintPath>$(FenrirWindowContractDir)Fenrir.Window.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
