<Project Sdk="Microsoft.NET.Sdk">
  <!-- The fixture's C# assembly for the generated defaults test: the contract (generated mirrors and hand-written parts),
       the generated Defaults class and the SDK stand-ins, loaded by Iris as a component. -->
  <PropertyGroup>
    <AssemblyName>Iris.Bindings.Fixture</AssemblyName>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- A mirror with a fixed buffer (Tag) is unsafe. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- The natives' class has no bodies until the SDK's generator writes them, and the facade parts (Bodies, Hits) call
         it: the SDK check compiles them. Body's methods call it too, so NativeStubs.cs stands in for the natives they call. -->
    <Compile Include="../../Fixture/Contract/**/*.cs"
             Exclude="../../Fixture/Contract/Generated/FixtureNative.cs;../../Fixture/Contract/Generated/Bodies.cs;../../Fixture/Contract/Generated/Hits.cs" />
    <Compile Include="../../Fixture/Uses/Contract/**/*.cs" />
    <Compile Include="../../Fixture/Tests/Generated/*.cs" />
    <Compile Include="../Stubs.cs" />
    <Compile Include="../NativeStubs.cs" />
  </ItemGroup>
</Project>
