{
  "binding": "FenrirPainter",
  "context": "Fenrir::CallContext",
  "functions": [
    {
      "name": "Overlay",
      "namespace": "Fenrir::PainterNatives",
      "source": "../src/PainterScripting.cpp",
      "state": "Fenrir::PainterScripting",
      "doc": "A painter over `window`'s overlay at `layer`, for the C# system that calls it: what it paints is submitted to the app's Overlay when that system's changes play back (as it returns, or as its hosted stage's group ends; Overlay::Submit), and the painter ends. Calls for the same window and layer before then give the same painter; one whose changes were discarded (its system threw) paints nothing after its frame. It draws in the window's logical units at a root scale of 1 and blends in gamma space, as UI on the window does, so a paragraph it draws is laid out at its sizes in logical pixels.",
      "facade": "Painter.Overlay",
      "facadeReturns": "painter",
      "returns": {
        "type": "void",
        "kind": "void",
        "doc": "The painter; none when the app has no Overlay (the renderer is not installed) or its asset store has no builtin:painter."
      },
      "parameters": [
        {
          "name": "window",
          "type": "Fenrir::WindowId",
          "kind": "struct",
          "doc": "The window, as the input and window contracts name it."
        },
        {
          "name": "layer",
          "type": "std::int32_t",
          "kind": "i32",
          "doc": "The overlay layer: lower layers draw first."
        },
        {
          "name": "painter",
          "type": "Fenrir::ScriptPainter::PainterId*",
          "kind": "pointer",
          "pointee": "Fenrir::ScriptPainter::PainterId",
          "pointeeKind": "struct",
          "output": true,
          "doc": "The painter."
        }
      ]
    },
